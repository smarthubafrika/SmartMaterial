<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared attributes are declared once and reused by multiple styleables. -->
    <attr name="smartButtonColor" format="color" />
    <attr name="smartButtonTextColor" format="color" />
    <attr name="smartCornerRadius" format="dimension" />
    <attr name="smartRippleColor" format="color" />
    <attr name="smartContentDescription" format="string" />
    <attr name="smartIconTint" format="color" />
    <attr name="smartCardColor" format="color" />
    <attr name="smartStrokeColor" format="color" />
    <attr name="smartStrokeWidth" format="dimension" />
    <attr name="smartElevation" format="dimension" />
    <attr name="smartLabel" format="string" />
    <attr name="smartHint" format="string" />
    <attr name="smartFillColor" format="color" />
    <attr name="smartFocusedStrokeColor" format="color" />
    <attr name="smartChipColor" format="color" />
    <attr name="smartTextColor" format="color" />
    <attr name="smartProgressColor" format="color" />
    <attr name="smartTrackColor" format="color" />
    <attr name="smartIndeterminate" format="boolean" />
    <attr name="smartProgress" format="float" />
    <attr name="smartBadgeColor" format="color" />
    <attr name="smartActiveColor" format="color" />
    <attr name="smartInactiveColor" format="color" />
    <attr name="smartValue" format="float" />
    <attr name="smartCheckedColor" format="color" />
    <attr name="smartUncheckedColor" format="color" />
    <attr name="smartChecked" format="boolean" />

    <declare-styleable name="SmartButton">
        <attr name="smartButtonColor" />
        <attr name="smartButtonTextColor" />
        <attr name="smartCornerRadius" />
        <attr name="smartRippleColor" />
        <attr name="smartContentDescription" />
    </declare-styleable>

    <declare-styleable name="SmartIconButton">
        <attr name="smartButtonColor" />
        <attr name="smartIconTint" />
        <attr name="smartCornerRadius" />
        <attr name="smartRippleColor" />
        <attr name="smartContentDescription" />
    </declare-styleable>

    <declare-styleable name="SmartCard">
        <attr name="smartCardColor" />
        <attr name="smartStrokeColor" />
        <attr name="smartStrokeWidth" />
        <attr name="smartElevation" />
        <attr name="smartCornerRadius" />
    </declare-styleable>

    <declare-styleable name="SmartTextField">
        <attr name="smartLabel" />
        <attr name="smartHint" />
        <attr name="smartFillColor" />
        <attr name="smartStrokeColor" />
        <attr name="smartFocusedStrokeColor" />
        <attr name="smartCornerRadius" />
    </declare-styleable>

    <declare-styleable name="SmartChip">
        <attr name="smartChipColor" />
        <attr name="smartTextColor" />
        <attr name="smartCornerRadius" />
        <attr name="smartRippleColor" />
    </declare-styleable>

    <declare-styleable name="SmartProgress">
        <attr name="smartProgressColor" />
        <attr name="smartTrackColor" />
        <attr name="smartIndeterminate" />
        <attr name="smartProgress" />
    </declare-styleable>

    <declare-styleable name="SmartSearchBar">
        <attr name="smartHint" />
        <attr name="smartFillColor" />
        <attr name="smartContentDescription" />
    </declare-styleable>

    <declare-styleable name="SmartBadge">
        <attr name="smartBadgeColor" />
        <attr name="smartTextColor" />
    </declare-styleable>

    <declare-styleable name="SmartSlider">
        <attr name="smartActiveColor" />
        <attr name="smartInactiveColor" />
        <attr name="smartValue" />
    </declare-styleable>

    <declare-styleable name="SmartSwitch">
        <attr name="smartCheckedColor" />
        <attr name="smartUncheckedColor" />
        <attr name="smartChecked" />
        <attr name="smartContentDescription" />
    </declare-styleable>

    <declare-styleable name="SmartCheckbox">
        <attr name="smartCheckedColor" />
        <attr name="smartUncheckedColor" />
        <attr name="smartChecked" />
        <attr name="smartContentDescription" />
    </declare-styleable>

    <declare-styleable name="SmartRadioButton">
        <attr name="smartCheckedColor" />
        <attr name="smartUncheckedColor" />
        <attr name="smartChecked" />
        <attr name="smartContentDescription" />
    </declare-styleable>

</resources>
